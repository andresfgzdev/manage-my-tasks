# Copy to .env.local and fill in. There is one environment: local development and
# Vercel use the same Atlas database; only BETTER_AUTH_URL changes between them.

# MongoDB Atlas: Database → Connect → Drivers → the connection string
# (mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=
MONGODB_DB=better-tasks

# Better Auth: a random secret (openssl rand -base64 32). Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The app's public URL, without a trailing slash: http://localhost:3000 locally,
# https://<your-domain> in Vercel
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in, the only way in: Google Cloud Console → Google Auth Platform → Clients
# (Web application). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only, never in Vercel: a throwaway local mongod for the MongoDB tests (npm test).
# They create and drop collections, so never point it at Atlas. Empty: those tests skip.
MONGODB_URI_TEST=
